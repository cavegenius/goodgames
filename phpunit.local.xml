<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnFailure="false" cacheDirectory="/tmp/phpunit-cache" backupStaticProperties="false">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">/var/www/tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">/var/www/tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <server name="APP_ENV" value="testing" force="true"/>
    <server name="APP_CONFIG_CACHE" value="/tmp/phpunit-config-cache.php" force="true"/>
    <server name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
    <server name="BCRYPT_ROUNDS" value="4" force="true"/>
    <server name="CACHE_STORE" value="array" force="true"/>
    <server name="DB_CONNECTION" value="sqlite" force="true"/>
    <server name="DB_DATABASE" value=":memory:" force="true"/>
    <server name="MAIL_MAILER" value="array" force="true"/>
    <server name="QUEUE_CONNECTION" value="sync" force="true"/>
    <server name="SESSION_DRIVER" value="array" force="true"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">/var/www/html/app</directory>
    </include>
  </source>
</phpunit>
